# Garby Backend — Environment Variables
# Copy this to .env and fill in real values.
# NEVER commit .env to the repository.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ── Detection APIs ────────────────────────────────────────────────────────────
HIVE_API_KEY=your-hive-moderation-api-key
SIGHTENGINE_USER=your-sightengine-user
SIGHTENGINE_SECRET=your-sightengine-secret

# ── AWS S3 Storage ────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=garby-uploads
AWS_REGION=us-east-1

# CDN base URL — optional, used if you have CloudFront or R2 custom domain
# CDN_BASE_URL=https://cdn.garby.app

# ── Cloudflare R2 (alternative to S3 — uncomment to use) ─────────────────────
# CF_ACCOUNT_ID=your-cloudflare-account-id
# AWS_ACCESS_KEY_ID=your-r2-access-key-id
# AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
# AWS_S3_BUCKET=garby-uploads
# CDN_BASE_URL=https://your-r2-custom-domain.com

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
